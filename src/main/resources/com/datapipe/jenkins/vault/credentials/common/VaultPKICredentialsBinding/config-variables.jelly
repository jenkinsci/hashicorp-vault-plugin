<?jelly escape-by-default='true'?>

<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <f:entry title="${%Certificate PEM variable}" field="certPemVariable">
    <f:textbox default="${descriptor.defaultCertPemVariable}"/>
  </f:entry>
  <f:entry title="${%Private key PEM variable}" field="privateKeyPemVariable">
    <f:textbox default="${descriptor.defaultKeyPemVariable}"/>
  </f:entry>
  <f:entry title="${%CA certificate PEM variable}" field="caPemVariable">
    <f:textbox default="${descriptor.defaultCaPemVariable}"/>
  </f:entry>
</j:jelly>
