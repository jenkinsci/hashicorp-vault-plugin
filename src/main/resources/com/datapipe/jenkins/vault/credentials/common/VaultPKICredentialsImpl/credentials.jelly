<?jelly escape-by-default='true'?>

<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:l="/lib/layout" xmlns:st="jelly:stapler">
  <f:entry title="${%Namespace}" field="namespace">
    <f:textbox/>
  </f:entry>
  <f:entry title="${%PKI Mount}" field="pkiMount">
    <f:textbox default="${descriptor.defaultPkiMount}"/>
  </f:entry>
  <f:entry title="${%PKI Role}" field="pkiRole">
    <f:textbox/>
  </f:entry>
  <f:entry title="${%Common Name}" field="commonName">
    <f:textbox/>
  </f:entry>
  <f:entry title="${%TTL}" field="ttl">
    <f:textbox default="${descriptor.defaultTtl}"/>
  </f:entry>
  <f:entry title="${%Alt Names (DNS SANs)}" field="altNames">
    <f:textbox/>
  </f:entry>
  <f:entry title="${%IP SANs}" field="ipSans">
    <f:textbox/>
  </f:entry>
  <st:include page="id-and-description" class="${descriptor.clazz}"/>

  <l:isAdmin>
    <f:validateButton title="${%Test Vault PKI issuance}" progress="${%Requesting certificate from Vault PKI...}"
      method="testConnection"
      with="pkiMount,pkiRole,commonName,ttl,altNames,ipSans,namespace"/>
  </l:isAdmin>

</j:jelly>
